# Database
DATABASE_URL="mysql://root:password@localhost:3306/cloudmantou"

# Docker Compose 数据库（APP_DATABASE_URL 中密码需按 URL 规则编码）
DB_NAME="cloudmantou"
DB_USER="cloudmantou"
DB_PASSWORD="replace-with-a-strong-database-password"
DB_ROOT_PASSWORD="replace-with-a-different-root-password"
APP_DATABASE_URL="mysql://cloudmantou:replace-with-url-encoded-password@mysql:3306/cloudmantou"

# Auth
AUTH_SECRET="replace-with-a-32-character-random-secret"
AUTH_URL="http://localhost:3000"

# Vault TOTP 二次验证（Authenticator 应用，base32 密钥）
# 生成：openssl rand -base64 20 | tr '+/' 'AB' | tr -d '=' | head -c 32
# VAULT_TOTP_SECRET="JBSWY3DPEHPK3PXP"

# Seed defaults (development)
# Admin: username admin / password admin123
SEED_ADMIN_PASSWORD="admin123"
SEED_USER_PASSWORD="test123"

# Optional cache/session store (启用后限流使用 Redis，多实例部署推荐)
REDIS_URL="redis://localhost:6379"
# 生产环境配置 REDIS_URL 后，API 限流在 Redis 不可用时 fail-closed（拒绝请求）
RATE_LIMIT_REQUIRE_REDIS="false"

# AI 编辑助手（Vercel AI SDK；环境变量模式的默认示例为 MiniMax）
# 也可登录后台“系统设置 → AI 模型”切换为数据库配置；密钥会使用
# SETTINGS_ENCRYPTION_KEY 加密，任何模式都切勿使用 NEXT_PUBLIC_ 前缀。
AI_ENABLED="false"
AI_PROVIDER_TYPE="anthropic-compatible"
AI_PROVIDER_NAME="minimax"
AI_BASE_URL="https://api.minimaxi.com/anthropic"
AI_API_KEY=""
AI_TEXT_MODEL="MiniMax-M3"
AI_ANTHROPIC_AUTH_MODE="auth-token"
AI_OPENAI_AUTH_MODE="bearer"
AI_REQUEST_TIMEOUT_MS="120000"
AI_SUPPORTS_STRUCTURED_OUTPUTS="true"
# 也兼容 MiniMax/Claude Code 风格变量：ANTHROPIC_BASE_URL、
# ANTHROPIC_AUTH_TOKEN、ANTHROPIC_API_KEY、ANTHROPIC_MODEL。
# 使用 OpenAI-compatible Provider 时：
# AI_PROVIDER_TYPE="openai-compatible"
# AI_BASE_URL="https://api.openai.com/v1"

# Docker 默认仅绑定到宿主机回环地址，由可信反代访问；不得把 3000 绕过反代暴露到公网
APP_BIND_ADDRESS="127.0.0.1"
TRUST_PROXY_HEADERS="true"

# 后台支付网关与 AI Provider 密钥加密（必填，缺失时对应密钥保存失败）
# 生成方式：openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY="replace-with-a-random-64-char-hex-string"

# 支付测试模式：仅当设为 true 时，后台 testMode 开关才会生效
PAYMENT_TEST_MODE="false"

# Card Secret Salt — 必填，用于卡密哈希。缺失时应用启动会报错。
# 生成方式：openssl rand -hex 32
CARD_SECRET_SALT="replace-with-a-random-64-char-hex-string"

# Payment providers
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_SELLER_ID=""
ALIPAY_ENV="sandbox"
ALIPAY_SANDBOX_GATEWAY="https://openapi-sandbox.dl.alipaydev.com/gateway.do"
ALIPAY_NOTIFY_URL="https://example.com/api/payment/notify/alipay"
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_KEY=""
WECHAT_API_V3_KEY=""
WECHAT_V3_PUBLIC_KEY=""
WECHAT_V3_PLATFORM_SERIAL=""
WECHAT_NOTIFY_URL="https://example.com/api/payment/notify/wechat"

# Local uploads (default: public/uploads; production should use a persistent path)
UPLOAD_DIR="public/uploads"
# 绝对路径上传目录时，需同时设置允许的根路径（如 /www/wwwroot/cloudmantou-data）
# UPLOAD_ALLOWED_ROOT="/www/wwwroot/cloudmantou-data"
# Production/BaoTa:
# UPLOAD_DIR="/www/wwwroot/cloudmantou-data/uploads"
# UPLOAD_ALLOWED_ROOT="/www/wwwroot/cloudmantou-data"

# 定时任务密钥（/api/cron/expire-orders 鉴权）
CRON_SECRET="replace-with-a-random-cron-secret"

# Optional object storage (reserved, not wired yet)
OSS_REGION=""
OSS_ACCESS_KEY=""
OSS_SECRET_KEY=""
OSS_BUCKET=""

# Site
# 官网版（official-site 分支）部署到 cloudmantoua.top 时：
NEXT_PUBLIC_SITE_MODE="official"
NEXT_PUBLIC_SITE_URL="https://cloudmantoua.top"
SITE_URL="https://cloudmantoua.top"
SITE_NAME="馒头助手"
# 官网电脑端安装包默认值；部署后可在后台“系统设置 → 客户端下载”中修改。
WINDOWS_DOWNLOAD_URL=""
MACOS_DOWNLOAD_URL=""
# 中间件读取维护状态时使用本机地址，避免依赖公网 DNS 回环。
INTERNAL_SITE_URL="http://127.0.0.1:3000"
# 博客版（main 分支）建议部署到子域：
# NEXT_PUBLIC_SITE_MODE="blog"
# SITE_URL="https://blog.cloudmantoua.top"
# SITE_NAME="馒头的博客"
